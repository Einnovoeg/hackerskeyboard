<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_preview_keyboard"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/summary_preview_keyboard"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />

    <EditText
        android:id="@+id/preview_field"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="@string/summary_preview_keyboard"
        android:inputType="textMultiLine"
        android:importantForAutofill="no"
        android:background="@drawable/preview_field_background"
        android:padding="16dp"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/preview_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:minWidth="140dp"
        android:text="@android:string/ok" />

</LinearLayout>
