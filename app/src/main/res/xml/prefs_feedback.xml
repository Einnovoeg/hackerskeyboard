<?xml version="1.0" encoding="utf-8"?>
<!-- Sounds and haptics: audio, vibration and the on-key preview popup. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:hk="http://schemas.android.com/apk/res-auto"
    android:title="@string/pref_screen_feedback_title"
    android:key="feedback_settings">

    <PreferenceCategory android:layout="@layout/preference_hk_category"
        android:key="group_sound_vibration"
        android:title="@string/settings_group_sound">

        <CheckBoxPreference android:layout="@layout/preference_hk"
            android:defaultValue="true"
            android:icon="@drawable/ic_hk_autocorrect"
            android:key="vibrate_on"
            android:persistent="true"
            android:summary="@string/summary_vibrate_on"
            android:title="@string/title_vibrate_on" />

        <org.pocketworkstation.pckeyboard.VibratePreference
            android:defaultValue="40"
            hk:displayFormat="%.0f ms"
            hk:logScale="true"
            hk:maxValue="200"
            hk:minValue="5"
            android:key="vibrate_len"
            android:persistent="true"
            android:title="@string/title_vibrate_len" />

        <CheckBoxPreference android:layout="@layout/preference_hk"
            android:defaultValue="true"
            android:icon="@drawable/ic_hk_speak"
            android:key="sound_on"
            android:persistent="true"
            android:summary="@string/summary_sound_on"
            android:title="@string/title_sound_on" />

        <CheckBoxPreference android:layout="@layout/preference_hk"
            android:defaultValue="true"
            android:icon="@drawable/ic_hk_speak"
            android:key="pref_mute_when_muted"
            android:persistent="true"
            android:summaryOff="@string/summary_mute_when_muted_off"
            android:summaryOn="@string/summary_mute_when_muted_on"
            android:title="@string/title_mute_when_muted" />

        <org.pocketworkstation.pckeyboard.AutoSummaryListPreference android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_key_sound_profile"
            android:entries="@array/key_sound_profile_entries"
            android:entryValues="@array/key_sound_profile_values"
            android:key="pref_key_sound_profile"
            android:persistent="true"
            android:title="@string/title_key_sound_profile" />

        <org.pocketworkstation.pckeyboard.AutoSummaryListPreference android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_click_method"
            android:entries="@array/click_method_entries"
            android:entryValues="@array/click_method_values"
            android:key="pref_click_method"
            android:persistent="true"
            android:title="@string/title_click_method" />

        <org.pocketworkstation.pckeyboard.SeekBarPreferenceString android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_click_volume"
            hk:asPercent="true"
            hk:maxValue="1"
            hk:minValue="0"
            android:key="pref_click_volume"
            android:persistent="true"
            android:title="@string/title_click_volume" />

        <CheckBoxPreference android:layout="@layout/preference_hk"
            android:defaultValue="@bool/default_popup_preview"
            android:icon="@drawable/ic_hk_preview"
            android:key="popup_on"
            android:persistent="true"
            android:title="@string/popup_on_keypress" />
    </PreferenceCategory>
</PreferenceScreen>
