<?xml version="1.0" encoding="utf-8"?>
<!-- Settings hub: every control lives on one of the grouped screens below. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="english_ime_settings"
    android:title="@string/english_ime_settings">

    <Preference android:layout="@layout/preference_hk"
        android:icon="@drawable/ic_hk_search"
        android:key="pref_search_settings"
        android:persistent="false"
        android:summary="@string/summary_search_settings"
        android:title="@string/title_search_settings">
        <intent
            android:targetPackage="org.pocketworkstation.pckeyboard"
            android:targetClass="org.pocketworkstation.pckeyboard.SearchSettingsActivity" />
    </Preference>

    <PreferenceCategory android:layout="@layout/preference_hk_category"
        android:key="hub_personalise"
        android:title="@string/settings_hub_personalise">

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_theme"
            android:key="pref_screen_view"
            android:persistent="false"
            android:summary="@string/pref_screen_view_title_summary"
            android:title="@string/pref_screen_view_title" />

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_size"
            android:key="pref_screen_layout"
            android:persistent="false"
            android:summary="@string/pref_screen_layout_title_summary"
            android:title="@string/pref_screen_layout_title" />

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_glyph"
            android:key="pref_screen_keys"
            android:persistent="false"
            android:summary="@string/pref_screen_keys_title_summary"
            android:title="@string/pref_screen_keys_title" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/preference_hk_category"
        android:key="hub_typing"
        android:title="@string/settings_hub_typing">

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_autocorrect"
            android:key="pref_screen_typing"
            android:persistent="false"
            android:summary="@string/pref_screen_typing_title_summary"
            android:title="@string/pref_screen_typing_title" />

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_effect"
            android:key="pref_screen_actions"
            android:persistent="false"
            android:summary="@string/pref_screen_actions_title_summary"
            android:title="@string/pref_screen_actions_title" />

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_speak"
            android:key="pref_screen_feedback"
            android:persistent="false"
            android:summary="@string/pref_screen_feedback_title_summary"
            android:title="@string/pref_screen_feedback_title" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/preference_hk_category"
        android:key="hub_system"
        android:title="@string/settings_hub_system">

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_snippets"
            android:key="pref_screen_tools"
            android:persistent="false"
            android:summary="@string/pref_screen_tools_title_summary"
            android:title="@string/pref_screen_tools_title" />

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_render"
            android:key="pref_screen_advanced"
            android:persistent="false"
            android:summary="@string/pref_screen_advanced_title_summary"
            android:title="@string/pref_screen_advanced_title" />
    </PreferenceCategory>
</PreferenceScreen>
