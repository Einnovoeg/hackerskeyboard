<?xml version="1.0" encoding="utf-8"?>
<!-- Appearance: themes, background art, animation and lighting. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:hk="http://schemas.android.com/apk/res-auto"
    android:key="prefs_view"
    android:title="@string/pref_screen_view_title">

    <org.pocketworkstation.pckeyboard.KeyboardPreviewPreference android:key="pref_theme_preview" />

    <PreferenceCategory android:layout="@layout/preference_hk_category"
        android:key="group_theme"
        android:title="@string/settings_group_theme">

        <org.pocketworkstation.pckeyboard.AutoSummaryListPreference android:layout="@layout/preference_hk"
            android:defaultValue="8"
            android:entries="@array/keyboard_layout_modes"
            android:entryValues="@array/keyboard_layout_modes_values"
            android:icon="@drawable/ic_hk_theme"
            android:key="pref_keyboard_layout"
            android:persistent="true"
            android:title="@string/keyboard_layout" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/preference_hk_category"
        android:key="group_background"
        android:title="@string/settings_group_background">

        <org.pocketworkstation.pckeyboard.AutoSummaryListPreference android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_key_effect"
            android:entries="@array/key_effect_entries"
            android:entryValues="@array/key_effect_values"
            android:icon="@drawable/ic_hk_effect"
            android:key="pref_key_effect"
            android:persistent="true"
            android:title="@string/title_key_effect" />

        <org.pocketworkstation.pckeyboard.SeekBarPreferenceString android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_background_animation_speed"
            hk:minValue="0.2"
            hk:maxValue="3.0"
            hk:step="0.1"
            hk:displayFormat="%.1f×"
            android:icon="@drawable/ic_hk_effect"
            android:key="pref_key_effect_speed"
            android:persistent="true"
            android:title="@string/title_background_animation_speed"
            android:summary="@string/summary_background_animation_speed" />

        <org.pocketworkstation.pckeyboard.SeekBarPreferenceString android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_background_animation_intensity"
            hk:minValue="10"
            hk:maxValue="100"
            hk:step="5"
            hk:displayFormat="%.0f%%"
            android:icon="@drawable/ic_hk_effect"
            android:key="pref_key_effect_intensity"
            android:persistent="true"
            android:title="@string/title_background_animation_intensity"
            android:summary="@string/summary_background_animation_intensity" />

        <Preference android:layout="@layout/preference_hk"
            android:icon="@drawable/ic_hk_theme"
            android:key="pref_background_image"
            android:persistent="false"
            android:title="@string/title_background_image"
            android:summary="@string/summary_background_image">
            <intent
                android:targetPackage="org.pocketworkstation.pckeyboard"
                android:targetClass="org.pocketworkstation.pckeyboard.BackgroundImageActivity" />
        </Preference>

        <org.pocketworkstation.pckeyboard.SeekBarPreferenceString android:layout="@layout/preference_hk"
            android:defaultValue="0"
            hk:minValue="0"
            hk:maxValue="0.8"
            hk:step="0.05"
            hk:asPercent="true"
            android:icon="@drawable/ic_hk_effect"
            android:key="pref_background_dim"
            android:persistent="true"
            android:title="@string/title_background_dim"
            android:summary="@string/summary_background_dim" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/preference_hk_category"
        android:key="group_lighting"
        android:title="@string/settings_group_lighting">

        <org.pocketworkstation.pckeyboard.AutoSummaryListPreference android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_key_press_effect"
            android:entries="@array/key_press_effect_entries"
            android:entryValues="@array/key_press_effect_values"
            android:icon="@drawable/ic_hk_effect"
            android:key="pref_key_press_effect"
            android:persistent="true"
            android:title="@string/title_key_press_effect"
            android:summary="@string/summary_key_press_effect" />

        <org.pocketworkstation.pckeyboard.AutoSummaryListPreference android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_key_accent"
            android:entries="@array/accent_color_entries"
            android:entryValues="@array/accent_color_values"
            android:icon="@drawable/ic_hk_color"
            android:key="pref_key_accent"
            android:persistent="true"
            android:title="@string/title_key_accent"
            android:summary="@string/summary_key_accent" />

        <org.pocketworkstation.pckeyboard.AutoSummaryListPreference android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_key_rgb_mode"
            android:entries="@array/key_rgb_mode_entries"
            android:entryValues="@array/key_rgb_mode_values"
            android:icon="@drawable/ic_hk_color"
            android:key="pref_key_rgb_mode"
            android:persistent="true"
            android:title="@string/title_key_rgb_mode"
            android:summary="@string/summary_key_rgb_mode" />

        <org.pocketworkstation.pckeyboard.SeekBarPreferenceString android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_key_rgb_speed"
            hk:minValue="0.2"
            hk:maxValue="3.0"
            hk:step="0.1"
            hk:displayFormat="%.1f×"
            android:icon="@drawable/ic_hk_effect"
            android:key="pref_key_rgb_speed"
            android:persistent="true"
            android:title="@string/title_key_rgb_speed" />

        <org.pocketworkstation.pckeyboard.SeekBarPreferenceString android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_key_rgb_hue"
            hk:minValue="0"
            hk:maxValue="360"
            hk:step="10"
            hk:displayFormat="%.0f°"
            android:icon="@drawable/ic_hk_color"
            android:key="pref_key_rgb_hue"
            android:persistent="true"
            android:title="@string/title_key_rgb_hue" />

        <org.pocketworkstation.pckeyboard.SeekBarPreferenceString android:layout="@layout/preference_hk"
            android:defaultValue="@string/default_key_rgb_brightness"
            hk:minValue="0.15"
            hk:maxValue="1.0"
            hk:step="0.05"
            hk:asPercent="true"
            android:icon="@drawable/ic_hk_size"
            android:key="pref_key_rgb_brightness"
            android:persistent="true"
            android:title="@string/title_key_rgb_brightness" />
    </PreferenceCategory>
</PreferenceScreen>
