<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="hk_clipboard.xml" />
        <exclude domain="sharedpref" path="hk_snippets.xml" />
        <exclude domain="sharedpref" path="hk_macros.xml" />
        <exclude domain="sharedpref" path="hk_context.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="hk_clipboard.xml" />
        <exclude domain="sharedpref" path="hk_snippets.xml" />
        <exclude domain="sharedpref" path="hk_macros.xml" />
        <exclude domain="sharedpref" path="hk_context.xml" />
    </device-transfer>
</data-extraction-rules>
